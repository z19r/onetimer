<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<meta name="description" content="<%= description %>">
<link rel="canonical" href="https://onetimer.z19r.com<%= nav == "docs" ? "/docs/" : "/" %>">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="/assets/css/tokens.css">
<link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a href="/" class="wordmark"><span class="wordmark-text">Onetimer</span><span class="wordmark-dot"></span></a>
    <nav class="site-nav">
      <a href="/docs/" class="<%= "active" if nav == "docs" %>">Documentation</a>
      <a href="https://rubygems.org/gems/onetimer">Reference</a>
      <a href="https://github.com/z19r/onetimer" class="button button--secondary button--sm">GitHub</a>
    </nav>
  </div>
</header>
<main>
<%= body %>
</main>
<footer class="site-footer">
  <div class="wrap">
    <span class="wordmark wordmark--sm"><span class="wordmark-text">Onetimer</span></span>
    <span class="footer-meta">MIT &middot; github.com/z19r/onetimer</span>
  </div>
</footer>
<script src="/assets/js/site.js" defer></script>
<script defer src="https://cloud.umami.is/script.js" data-website-id="f09e1068-11ea-4493-a6c5-a9d8365ffb23"></script>
</body>
</html>
